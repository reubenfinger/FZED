-LPW: dw 0,FXLT,FXLT,FXLC,FXLR,FXLT,1,FXLU,SVLV,FXLX,FXLD,FXLBW,FXLE,FXLQW
+LPW: dw 0,FXLT,FXLT,FXLC,FXLR,FXLT,1,FXLU,SVLV,FXLXW,FXLDW,FXLBW,FXLEW,FXLQW
 LPM: dw 0,FXLTM,FXLTM,FXLCM,FXLRM,FXLTM,1,FXLU,SVLV,FXLX,FXLD,FXLB,FXLE,FXLQ
 RINGPAR:            ; carrier step (16.16 per sample) from CC94 and the voice rate, locked to the active loop; RTAB shape
     call L61DB
@@ -1221,20 +1221,16 @@
 .ok: cmp word [FXW],16384
     jz .st
     push bx
-    push dx
     mov ax,dx
+    mov bx,[si]
+    sub ax,bx
+    jo .of
     imul word [FXW]
-    mov bx,ax
-    mov di,dx
-    mov ax,[si]
-    imul word [FXW2]
-    add ax,bx
-    adc dx,di
-    shr ax,14
-    shl dx,2
-    or ax,dx
-    mov dx,ax
-    pop bx
+.j: shl ax,1
+    rcl dx,1
+    shl ax,1
+    rcl dx,1
+    add dx,bx
     pop bx
 .st: mov [si],dx
     add si,2
@@ -1242,6 +1238,8 @@
     loop .l
     pop es
     ret
+.of: call MIXOV
+    jmp .j
 LVCPY:              ; making the clean copy, 128 words per main-loop pass (MIDI keeps flowing)
     mov ax,[LVLEN]
     mov dx,[LVLEN+2]
